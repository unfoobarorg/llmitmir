# Geheimer Schlüssel, den LLMitMir mitschickt (mindestens 24 Zeichen). install.sh erzeugt ihn.
WERKBANK_TOKEN=
# Port auf der VM
WERKBANK_PORT=8787
# Grenzen je Sandbox (je Chat/Aufgabe eine)
SANDBOX_MEMORY=3g
SANDBOX_CPUS=2
SANDBOX_PIDS=512
# bridge = Internetzugang (pip, Webseiten, Home Assistant, Nextcloud); none = komplett offline
SANDBOX_NETWORK=bridge
# höchstens so viele Sandboxen gleichzeitig; ungenutzte werden nach IDLE_TIMEOUT Sekunden entfernt
MAX_SESSIONS=6
IDLE_TIMEOUT=7200
MAX_EXEC_TIMEOUT=3600
SANDBOX_IMAGE=llmitmir-werkbank-sandbox:latest
TZ=Europe/Berlin
